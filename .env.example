# ============================================================
# MySQL MCP Server 环境变量配置
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 根据实际情况修改 .env 中的值
#   3. 启动服务：npm start
# ============================================================

# ---- 数据库连接（必填） ----

# MySQL 用户名（必填，无默认值）
MYSQL_USER=root

# MySQL 密码（必填，无默认值）
MYSQL_PASSWORD=your_password

# 目标数据库名称（必填，无默认值）
MYSQL_DATABASE=your_database

# ---- 数据库连接（可选） ----

# MySQL 服务器地址，默认 127.0.0.1
MYSQL_HOST=127.0.0.1

# MySQL 服务器端口，默认 3306
MYSQL_PORT=3306

# ---- 安全控制 ----

# 是否允许写操作（INSERT / UPDATE / DELETE / DROP / CREATE 等）
# 默认 false（禁止），设为 true 开启
# 安全建议：生产环境保持为 false，使用只读数据库账户
ALLOW_WRITE=true

# 是否允许多条 SQL 语句在一次调用中执行（以 ; 分隔）
# 默认 false（禁止），设为 true 开启
# 安全建议：保持为 false，除非明确需要批量执行
MYSQL_MULTIPLE_STATEMENTS=false
